
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    // Email sign-ups must confirm their address before joining or posting.
    // Google and GitHub confirm the email themselves.
    function isVerified() {
      return request.auth != null && (
        request.auth.token.email_verified == true ||
        request.auth.token.firebase.sign_in_provider in ['google.com', 'github.com']
      );
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Moderators have the `moderator` custom claim on their Firebase Auth
    // account (scripts/set-moderator.mjs). They review reported posts on
    // /moderation.
    function isModerator() {
      return request.auth != null && request.auth.token.moderator == true;
    }

    // ---- Moderators acting on members' groups, meetups and other items ----
    // Every such action is saved with a new moderationLog entry in the same
    // write (src/app/moderation/useItemModeration.ts), so it's on the record.

    // True when this write creates moderationLog/<logId>
    function isLoggedByModerator(logId) {
      let logPath = /databases/$(database)/documents/moderationLog/$(logId);
      return isModerator() && !exists(logPath) && existsAfter(logPath);
    }

    // Deleting an item, like studyGroups/abc, is logged as
    // moderationLog/delete-studyGroups-abc
    function isModeratorDeleting(kind, id) {
      return isLoggedByModerator('delete-' + kind + '-' + id);
    }

    // A task, check-in, update or entry goes with its item (any time after
    // the item's deletion was logged), or on its own with its own entry, like
    // moderationLog/delete-studyGroups-abc-checkIns-xyz
    function isModeratorDeletingPart(kind, id, part, partId) {
      return isModerator()
             && (existsAfter(/databases/$(database)/documents/moderationLog/$('delete-' + kind + '-' + id))
                 || isLoggedByModerator('delete-' + kind + '-' + id + '-' + part + '-' + partId));
    }

    // A moderator edits only the item's wording (`keys`), naming a new
    // moderationLog entry about this item in `moderationLogId`
    function isModeratorEditing(kind, id, keys) {
      let logId = request.resource.data.moderationLogId;
      let logPath = /databases/$(database)/documents/moderationLog/$(logId);
      return isModerator()
             && logId is string
             && changedKeys().hasOnly(keys.concat(['moderationLogId']))
             && !exists(logPath)
             && getAfter(logPath).data.action == 'edit-content'
             && getAfter(logPath).data.contentPath == kind + '/' + id;
    }

    function isModeratorEditingGroup(kind, id) {
      return isModeratorEditing(kind, id, ['name', 'name_lowercase', 'topic', 'description'])
             && isValidGroup(request.resource.data);
    }

    // Study groups, group projects and book clubs share these rules.
    // `kind` is the collection name, like 'studyGroups'.
    function groupData(kind, groupId) {
      return get(/databases/$(database)/documents/$(kind)/$(groupId)).data;
    }

    function isGroupMemberOf(kind, groupId) {
      return request.auth != null && groupData(kind, groupId).memberIds.hasAny([request.auth.uid]);
    }

    function isGroupCreatorOf(kind, groupId) {
      return request.auth != null && groupData(kind, groupId).creatorId == request.auth.uid;
    }

    function isValidGroup(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 75
             && data.topic is string && data.topic.size() > 0 && data.topic.size() <= 50
             && data.description is string && data.description.size() <= 500
             && data.commitmentDays is list && data.commitmentDays.size() > 0 && data.commitmentDays.size() <= 7
             && (!('openToJoinAnytime' in data) || data.openToJoinAnytime is bool)
             && (!('startDate' in data) || data.startDate is timestamp);
    }

    // A start date being set must be ahead, and at most 90 days away
    // (MAX_START_DAYS in src/lib/constants.ts)
    function isAllowedStartDate(data) {
      return !('startDate' in data)
             || (data.startDate > request.time && data.startDate < request.time + duration.value(90, 'd'));
    }

    // Only book clubs can stay open to join after their first week
    function hasNoAnytimeJoin() {
      return !('openToJoinAnytime' in request.resource.data);
    }

    function canCreateGroup() {
      return isVerified()
             && request.resource.data.creatorId == request.auth.uid
             && request.resource.data.memberIds == [request.auth.uid]
             // The real time, so the join window can't be stretched
             && request.resource.data.createdAt == request.time
             && isValidGroup(request.resource.data)
             && isAllowedStartDate(request.resource.data);
    }

    // Joining adds only yourself, while there's room, until the group starts
    // (its start date, or two weeks after it was created; see joinDeadline in
    // src/lib/groups.ts), or any time for a book club that stays open
    function isJoiningGroup() {
      return isVerified()
             && changedKeys().hasOnly(['memberIds'])
             && resource.data.memberIds.size() < 25
             && ((('startDate' in resource.data)
                    ? request.time < resource.data.startDate
                    : request.time - resource.data.createdAt < duration.value(14, 'd'))
                 || resource.data.get('openToJoinAnytime', false) == true)
             && isAddingSelfToList(request.resource.data.memberIds, resource.data.memberIds);
    }

    // Anyone but the creator can leave; the creator deletes the group instead
    function isLeavingGroup() {
      return changedKeys().hasOnly(['memberIds'])
             && resource.data.creatorId != request.auth.uid
             && isRemovingSelfFromList(request.resource.data.memberIds, resource.data.memberIds);
    }

    function isEditingGroup() {
      return isVerified()
             && resource.data.creatorId == request.auth.uid
             && changedKeys().hasOnly(['name', 'name_lowercase', 'topic', 'description', 'commitment', 'commitmentDays', 'startTime', 'timezone', 'githubUrl', 'openToJoinAnytime', 'startDate'])
             && isValidGroup(request.resource.data)
             // A new start date must be ahead; an unchanged one can be in the past
             && (!changedKeys().hasAny(['startDate']) || isAllowedStartDate(request.resource.data));
    }

    function isValidNewCheckIn() {
      return isVerified()
             && request.resource.data.userId == request.auth.uid
             && request.resource.data.content is string
             && request.resource.data.content.size() > 0 && request.resource.data.content.size() <= 2000
             && request.resource.data.type in ['daily', 'weekly'];
    }

    // Only the author can edit a check-in, and it stays theirs
    function isEditingOwnCheckIn() {
      return request.auth != null
             && resource.data.userId == request.auth.uid
             && request.resource.data.userId == resource.data.userId
             && request.resource.data.content is string
             && request.resource.data.content.size() > 0 && request.resource.data.content.size() <= 2000;
    }
    
    function isMeetupCreator(meetupId) {
      return request.auth != null && get(/databases/$(database)/documents/meetups/$(meetupId)).data.creatorId == request.auth.uid;
    }
    
    function isMeetupAttendee(meetupId) {
       return request.auth != null && get(/databases/$(database)/documents/meetups/$(meetupId)).data.attendeeIds.hasAny([request.auth.uid]);
    }

    function isMentorshipMember(mentorshipId) {
      return request.auth != null && get(/databases/$(database)/documents/mentorships/$(mentorshipId)).data.memberIds.hasAny([request.auth.uid]);
    }
    
    function isTutorshipMember(tutorshipId) {
      return request.auth != null && get(/databases/$(database)/documents/tutorships/$(tutorshipId)).data.memberIds.hasAny([request.auth.uid]);
    }

    function isPairingMember(pairingId) {
      return request.auth != null && get(/databases/$(database)/documents/pairings/$(pairingId)).data.memberIds.hasAny([request.auth.uid]);
    }

    // Members can list the mentorships, tutorships or pairings they're in,
    // with where('memberIds', 'array-contains', <their uid>). Every result
    // must include them, so a query without that filter is refused.
    function isListingOwnConnections() {
      return request.auth != null && resource.data.memberIds.hasAny([request.auth.uid]);
    }

    function isAddingSelfToList(listAfter, listBefore) {
      return request.auth != null
             && listAfter.size() == listBefore.size() + 1
             && listAfter.hasAll(listBefore)
             && listAfter.hasAny([request.auth.uid])
             && !listBefore.hasAny([request.auth.uid]);
    }
    
    function isRemovingSelfFromList(listAfter, listBefore) {
      return request.auth != null
             && listBefore.size() == listAfter.size() + 1
             && listBefore.hasAll(listAfter)
             && listBefore.hasAny([request.auth.uid])
             && !listAfter.hasAny([request.auth.uid]);
    }
    
    // Mentorships, tutorships and pairings are named after both members' IDs,
    // sorted and joined with "_", like "abc_xyz"
    function connectionIdWith(otherId) {
      return request.auth.uid < otherId
        ? request.auth.uid + '_' + otherId
        : otherId + '_' + request.auth.uid;
    }

    // Requests are only ever changed by the person they were sent to, and only
    // to accept or decline them, once.
    function isAnsweringRequest() {
      return request.auth != null
             && request.auth.uid == resource.data.toUid
             && resource.data.status == 'pending'
             && changedKeys().hasOnly(['status'])
             && request.resource.data.status in ['accepted', 'declined'];
    }

    // True when `fromId` sent the caller this request and the save being
    // checked is the one accepting it: it was pending before and is accepted
    // after.
    function isAcceptingRequest(requestsCollection, requestId, fromId) {
      let before = get(/databases/$(database)/documents/$(requestsCollection)/$(requestId)).data;
      let after = getAfter(/databases/$(database)/documents/$(requestsCollection)/$(requestId)).data;
      return before.fromUid == fromId
             && before.toUid == request.auth.uid
             && before.status == 'pending'
             && after.status == 'accepted';
    }

    // A mentorship, tutorship or pairing is saved by the person accepting the
    // request, in the same save that accepts it. It names the request, holds
    // exactly the two people on it, and nothing the app doesn't write.
    // `roleKeys` are the extra fields, like ['mentorId', 'menteeId'].
    function isStartingConnection(connectionId, requestsCollection, roleKeys) {
      let data = request.resource.data;
      let fromId = get(/databases/$(database)/documents/$(requestsCollection)/$(data.requestId)).data.fromUid;
      return isVerified()
             && data.keys().hasOnly(['id', 'memberIds', 'requestId', 'createdAt'].concat(roleKeys))
             && connectionId == connectionIdWith(fromId)
             && data.id == connectionId
             && data.memberIds.size() == 2
             && data.memberIds.hasAll([request.auth.uid, fromId])
             && data.createdAt == request.time
             && isAcceptingRequest(requestsCollection, data.requestId, fromId);
    }

    // Mentorship and tutorship requests say which role the sender wants
    // filled: "seeking_mentor" means the person accepting becomes the mentor.
    function hasRolesFromRequest(requestsCollection, offerer, seeker) {
      let data = request.resource.data;
      let sent = get(/databases/$(database)/documents/$(requestsCollection)/$(data.requestId)).data;
      return (sent.type == 'seeking_' + offerer
              && data[offerer + 'Id'] == request.auth.uid
              && data[seeker + 'Id'] == sent.fromUid)
          || (sent.type == 'seeking_' + seeker
              && data[offerer + 'Id'] == sent.fromUid
              && data[seeker + 'Id'] == request.auth.uid);
    }

    function isStartingRoleConnection(connectionId, requestsCollection, offerer, seeker) {
      return isStartingConnection(connectionId, requestsCollection, [offerer + 'Id', seeker + 'Id'])
             && hasRolesFromRequest(requestsCollection, offerer, seeker);
    }

    // Profiles are public, so they must never hold an email address.
    // Firebase Auth already keeps each member's email privately.
    // `createdAt` is when the account was made, set once at signup and never
    // changed.
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId) && !('email' in request.resource.data)
                    && (!('createdAt' in request.resource.data) || request.resource.data.createdAt == request.time)
                    && (!('username' in request.resource.data || 'username_lowercase' in request.resource.data)
                        || hasClaimedUsername(request.resource.data));
      allow delete: if isOwner(userId);
      allow update: if !('email' in request.resource.data) && (
        (isOwner(userId) && !changedKeys().hasAny(['createdAt'])
          && request.resource.data.get('privateAccount', false) is bool
          && (!setsUsername(request.resource.data, resource.data) || hasClaimedUsername(request.resource.data))) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().size() == 1 &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followers']) &&
          // A private account's followers are added by the account itself,
          // when it accepts a follow request (match /followRequests)
          ((isVerified() && !hasBlocked(userId, request.auth.uid) && !hasPrivateAccount(userId)
              && isAddingSelfToList(request.resource.data.followers, resource.data.get('followers', []))) ||
            isRemovingSelfFromList(request.resource.data.followers, resource.data.get('followers', [])))
        )
      );
    }

    // True when `userId` has blocked `otherId` (users/{userId}/private/feedPrefs)
    function hasBlocked(userId, otherId) {
      let prefsPath = /databases/$(database)/documents/users/$(userId)/private/feedPrefs;
      return exists(prefsPath) && get(prefsPath).data.get('blockedIds', []).hasAny([otherId]);
    }

    // Names nobody can sign up with, so no one can pose as the site's staff.
    // Keep in step with RESERVED_USERNAMES in src/lib/usernames.ts.
    function isReservedUsername(name) {
      return name in [
        'root', 'admin', 'administrator', 'abuse', 'webmaster', 'spam', 'help', 'support',
        'administratorrequest', 'invalid', 'valid', 'error', 'motd', 'authenticateduser',
        'moderator', 'staff', 'official', 'security', 'system', 'w3develops'
      ];
    }

    // A username document is named after the lowercase username: 3 to 24
    // letters and numbers, as the signup form checks
    function isClaimableUsername(name) {
      return name.matches('^[a-z0-9]{3,24}$') && !isReservedUsername(name);
    }

    // A profile's username must be one the member has claimed (in the same
    // write, at signup), so the rules above can't be skipped by writing the
    // profile directly
    function hasClaimedUsername(data) {
      return data.username is string
             && data.username_lowercase == data.username.lower()
             && getAfter(/databases/$(database)/documents/usernames/$(data.username_lowercase)).data.uid == request.auth.uid;
    }

    function setsUsername(data, before) {
      return data.diff(before).affectedKeys().hasAny(['username', 'username_lowercase']);
    }

    match /usernames/{username} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.uid
                    && request.resource.data.keys().hasOnly(['uid'])
                    && isClaimableUsername(username);
      allow update: if false;
      // Lets members free up their username when they delete their account
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if false; 
    }

    // w3Develops' own posts (community insights and news roundups), written
    // only by the scheduler in functions/src/posts.ts through the Admin SDK
    match /posts/{postId} {
      allow read: if true;
      allow write: if false;
    }

    // ---- Member articles on /news (src/lib/articles.ts) ----
    // Members apply to write; moderators approve them as writers; writers
    // draft and submit articles; moderators publish or send them back.

    function isWriter(userId) {
      return exists(/databases/$(database)/documents/writers/$(userId));
    }

    function isValidWriterApplication(data) {
      return data.about is string && data.about.size() > 0 && data.about.size() <= 1000
             && !hasBlockedWord(data.about)
             && data.links is list && data.links.size() >= 1 && data.links.size() <= 3
             && data.links.join(' ').matches('https://[^\\s]{1,300}( https://[^\\s]{1,300}){0,2}')
             && data.topics is list && data.topics.size() <= 5;
    }

    match /writerApplications/{userId} {
      allow read: if isOwner(userId) || isModerator();
      allow create: if isOwner(userId) && isVerified()
                    && request.resource.data.keys().hasOnly(['about', 'links', 'topics', 'status', 'createdAt'])
                    && request.resource.data.status == 'pending'
                    && request.resource.data.createdAt == request.time
                    && isValidWriterApplication(request.resource.data);
      // Applying again after a "not yet", or a moderator's decision
      allow update: if (isOwner(userId) && resource.data.status == 'rejected'
                        && changedKeys().hasOnly(['about', 'links', 'topics', 'status', 'createdAt', 'reviewedBy', 'reviewedAt', 'note'])
                        && request.resource.data.keys().hasOnly(['about', 'links', 'topics', 'status', 'createdAt'])
                        && request.resource.data.status == 'pending'
                        && request.resource.data.createdAt == request.time
                        && isValidWriterApplication(request.resource.data))
                    || (isModerator() && resource.data.status == 'pending'
                        && changedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt', 'note'])
                        && request.resource.data.status in ['approved', 'rejected']
                        && request.resource.data.reviewedBy == request.auth.uid
                        && request.resource.data.reviewedAt == request.time
                        && request.resource.data.note is string && request.resource.data.note.size() <= 500
                        && (request.resource.data.status == 'rejected' || existsAfter(/databases/$(database)/documents/writers/$(userId))));
      allow delete: if isOwner(userId);
    }

    // Approved writers, public so their articles can say so
    match /writers/{userId} {
      allow read: if true;
      allow create: if isModerator()
                    && request.resource.data.keys().hasOnly(['approvedBy', 'approvedAt'])
                    && request.resource.data.approvedBy == request.auth.uid
                    && request.resource.data.approvedAt == request.time;
      allow update: if false;
      allow delete: if isModerator();
    }

    function isValidArticle(data) {
      return data.title is string && data.title.size() >= 10 && data.title.size() <= 120
             && data.summary is string && data.summary.size() > 0 && data.summary.size() <= 300
             && data.body is string && data.body.size() > 0 && data.body.size() <= 20000
             && data.topic in ['programming', 'career', 'ai', 'security', 'open-source', 'community', 'other']
             && !hasBlockedWord(data.title) && !hasBlockedWord(data.summary) && !hasBlockedWord(data.body);
    }

    match /articles/{articleId} {
      allow read: if resource.data.status == 'published'
                  || isModerator()
                  || (request.auth != null && resource.data.authorId == request.auth.uid);
      allow create: if isVerified() && isWriter(request.auth.uid)
                    && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'authorPhoto', 'title', 'summary', 'body', 'topic', 'status', 'createdAt', 'updatedAt'])
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.authorName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username
                    && request.resource.data.authorPhoto == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('profilePictureUrl', '')
                    && request.resource.data.status in ['draft', 'submitted']
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time
                    && isValidArticle(request.resource.data);
      // Writers change their drafts, submit them, and fix ones sent back;
      // moderators publish or send back submitted ones
      allow update: if (request.auth != null && resource.data.authorId == request.auth.uid
                        && isWriter(request.auth.uid)
                        && resource.data.status in ['draft', 'submitted', 'rejected']
                        && changedKeys().hasOnly(['title', 'summary', 'body', 'topic', 'status', 'updatedAt'])
                        && request.resource.data.status in ['draft', 'submitted']
                        && request.resource.data.updatedAt == request.time
                        && isValidArticle(request.resource.data))
                    || (isModerator()
                        && changedKeys().hasOnly(['status', 'editorNote', 'publishedAt', 'reviewedBy'])
                        && request.resource.data.reviewedBy == request.auth.uid
                        && request.resource.data.get('editorNote', '') is string && request.resource.data.get('editorNote', '').size() <= 500
                        && ((resource.data.status == 'submitted' && request.resource.data.status == 'published' && request.resource.data.publishedAt == request.time)
                            || (resource.data.status in ['submitted', 'published'] && request.resource.data.status == 'rejected')));
      allow delete: if (request.auth != null && resource.data.authorId == request.auth.uid && resource.data.status != 'published')
                    || isModerator();
    }
    
    match /mentorshipRequests/{requestId} {
        allow read: if request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid;
        allow create: if isVerified() && request.auth.uid == request.resource.data.fromUid
                      && request.resource.data.status == 'pending'
                      && request.resource.data.fromUid != request.resource.data.toUid;
        allow update: if isAnsweringRequest();
    }

    match /mentorships/{mentorshipId} {
      allow get: if isMentorshipMember(mentorshipId);
      allow list: if isListingOwnConnections();
      // Saved again if the two reconnect later
      allow create, update: if isStartingRoleConnection(mentorshipId, 'mentorshipRequests', 'mentor', 'mentee');
      allow delete: if false;

      match /tasks/{taskId} {
        allow read: if isMentorshipMember(mentorshipId);
        allow create: if isVerified() && isMentorshipMember(mentorshipId)
                      && request.resource.data.creatorId == request.auth.uid
                      && request.resource.data.isCompleted == false;
        allow update: if isMentorshipMember(mentorshipId);
        allow delete: if isMentorshipMember(mentorshipId) && resource.data.creatorId == request.auth.uid;
      }
      
      match /checkIns/{checkInId} {
        allow read: if isMentorshipMember(mentorshipId);
        allow create: if isMentorshipMember(mentorshipId) && isValidNewCheckIn();
        allow update: if isEditingOwnCheckIn();
        allow delete: if false;
      }
      
      match /notes/{noteId} {
        allow read: if isMentorshipMember(mentorshipId);
        allow write: if isVerified() && isMentorshipMember(mentorshipId);
      }
    }
    
     match /tutorRequests/{requestId} {
        allow read: if request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid;
        allow create: if isVerified() && request.auth.uid == request.resource.data.fromUid
                      && request.resource.data.status == 'pending'
                      && request.resource.data.fromUid != request.resource.data.toUid;
        allow update: if isAnsweringRequest();
    }

    match /tutorships/{tutorshipId} {
      allow get: if isTutorshipMember(tutorshipId);
      allow list: if isListingOwnConnections();
      // Saved again if the two reconnect later
      allow create, update: if isStartingRoleConnection(tutorshipId, 'tutorRequests', 'tutor', 'student');
      allow delete: if false;

      match /tasks/{taskId} {
        allow read: if isTutorshipMember(tutorshipId);
        allow create: if isVerified() && isTutorshipMember(tutorshipId)
                      && request.resource.data.creatorId == request.auth.uid
                      && request.resource.data.isCompleted == false;
        allow update: if isTutorshipMember(tutorshipId);
        allow delete: if isTutorshipMember(tutorshipId) && resource.data.creatorId == request.auth.uid;
      }
      
      match /checkIns/{checkInId} {
        allow read: if isTutorshipMember(tutorshipId);
        allow create: if isTutorshipMember(tutorshipId) && isValidNewCheckIn();
        allow update: if isEditingOwnCheckIn();
        allow delete: if false;
      }
      
       match /notes/{noteId} {
        allow read: if isTutorshipMember(tutorshipId);
        allow write: if isVerified() && isTutorshipMember(tutorshipId);
      }
    }
    
    match /pairRequests/{requestId} {
        allow read: if request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid;
        allow create: if isVerified() && request.auth.uid == request.resource.data.fromUid
                      && request.resource.data.status == 'pending'
                      && request.resource.data.fromUid != request.resource.data.toUid;
        allow update: if isAnsweringRequest();
    }

    match /pairings/{pairingId} {
      allow get: if isPairingMember(pairingId);
      allow list: if isListingOwnConnections();
      // Saved again if the two reconnect later
      allow create, update: if isStartingConnection(pairingId, 'pairRequests', []);
      allow delete: if false;

      match /tasks/{taskId} {
        allow read: if isPairingMember(pairingId);
        allow create: if isVerified() && isPairingMember(pairingId)
                      && request.resource.data.creatorId == request.auth.uid
                      && request.resource.data.isCompleted == false;
        allow update: if isPairingMember(pairingId);
        allow delete: if isPairingMember(pairingId) && resource.data.creatorId == request.auth.uid;
      }
      
      match /checkIns/{checkInId} {
        allow read: if isPairingMember(pairingId);
        allow create: if isPairingMember(pairingId) && isValidNewCheckIn();
        allow update: if isEditingOwnCheckIn();
        allow delete: if false;
      }
      
       match /notes/{noteId} {
        allow read: if isPairingMember(pairingId);
        allow write: if isVerified() && isPairingMember(pairingId);
      }
    }

    match /competitions/{competitionId} {
      allow read: if true;
      allow create: if isVerified() && request.resource.data.creatorId == request.auth.uid;
      allow update: if (request.auth != null && resource.data.creatorId == request.auth.uid)
                    || isModeratorEditing('competitions', competitionId, ['name', 'name_lowercase', 'description', 'rules', 'prize']);
      allow delete: if (request.auth != null && resource.data.creatorId == request.auth.uid)
                    || isModeratorDeleting('competitions', competitionId);

      match /entries/{entryId} {
        allow read: if true;
        allow create: if isVerified()
                      && request.resource.data.userId == request.auth.uid
                      && get(/databases/$(database)/documents/competitions/$(competitionId)).data.endDate > request.time
                      && request.resource.data.username is string
                      && request.resource.data.projectUrl is string
                      && request.resource.data.voterIds == [];
        // The entrant can edit their entry while the competition is open, but
        // not its votes or owner
        allow update: if (request.auth != null && resource.data.userId == request.auth.uid
                          && get(/databases/$(database)/documents/competitions/$(competitionId)).data.endDate > request.time
                          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['voterIds', 'userId'])) ||
                      // Other members can vote for an entry, or take their vote back
                      (isVerified() && resource.data.userId != request.auth.uid
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['voterIds'])
                          && (isAddingSelfToList(request.resource.data.voterIds, resource.data.get('voterIds', []))
                              || isRemovingSelfFromList(request.resource.data.voterIds, resource.data.get('voterIds', []))));
        allow delete: if (request.auth != null && resource.data.userId == request.auth.uid)
                      || isModeratorDeletingPart('competitions', competitionId, 'entries', entryId);
      }
    }

    match /jobs/{jobId} {
      allow read: if true;
      allow create: if isVerified() && request.resource.data.postedById == request.auth.uid;
      allow update: if (request.auth != null && resource.data.postedById == request.auth.uid)
                    || isModeratorEditing('jobs', jobId, ['title', 'title_lowercase', 'companyName', 'location', 'description', 'applyUrl']);
      allow delete: if (request.auth != null && resource.data.postedById == request.auth.uid)
                    || isModeratorDeleting('jobs', jobId);
    }

    // The free services directory on /marketplace (src/lib/services.ts).
    // Each member has up to 5 listings, named "<uid>_1" to "<uid>_5". People
    // contact them through their profile or the optional https link; no
    // email addresses are stored, and no payments are handled.
    function isValidServiceListing(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 80
             && data.description is string && data.description.size() > 0 && data.description.size() <= 1000
             && !hasBlockedWord(data.title) && !hasBlockedWord(data.description)
             && data.category in ['websites', 'mobile', 'design', 'marketing', 'writing', 'data', 'devops', 'tutoring', 'tasks', 'other']
             && data.skills is list && data.skills.size() <= 8
             && (data.skills.size() == 0 || data.skills.join(',').matches('[a-z0-9.+# -]{1,30}(,[a-z0-9.+# -]{1,30}){0,7}'))
             && data.priceNote is string && data.priceNote.size() <= 60
             && (!('contactUrl' in data) || (data.contactUrl is string && data.contactUrl.size() <= 300 && data.contactUrl.matches('https://[^\\s]+')));
    }

    match /serviceListings/{listingId} {
      allow read: if true;
      allow create: if isVerified()
                    && listingId.matches(request.auth.uid + '_[1-5]')
                    && request.resource.data.keys().hasOnly(['ownerId', 'ownerName', 'ownerPhoto', 'title', 'description', 'category', 'skills', 'priceNote', 'contactUrl', 'createdAt', 'updatedAt'])
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.ownerName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username
                    && request.resource.data.ownerPhoto == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('profilePictureUrl', '')
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time
                    && isValidServiceListing(request.resource.data);
      allow update: if (request.auth != null && resource.data.ownerId == request.auth.uid
                        && changedKeys().hasOnly(['title', 'description', 'category', 'skills', 'priceNote', 'contactUrl', 'updatedAt'])
                        && request.resource.data.updatedAt == request.time
                        && isValidServiceListing(request.resource.data))
                    || isModeratorEditing('serviceListings', listingId, ['title', 'description', 'priceNote']);
      allow delete: if (request.auth != null && resource.data.ownerId == request.auth.uid)
                    || isModeratorDeleting('serviceListings', listingId);
    }

    match /studyGroups/{groupId} {
      allow read: if true;
      allow create: if canCreateGroup() && hasNoAnytimeJoin();
      allow update: if ((isJoiningGroup() || isLeavingGroup() || isEditingGroup()) && hasNoAnytimeJoin())
                    || isModeratorEditingGroup('studyGroups', groupId);
      allow delete: if (request.auth != null && resource.data.creatorId == request.auth.uid)
                    || isModeratorDeleting('studyGroups', groupId);

      match /tasks/{taskId} {
        allow read: if true;
        allow create: if isVerified() && isGroupMemberOf('studyGroups', groupId)
                      && request.resource.data.creatorId == request.auth.uid
                      && request.resource.data.isCompleted == false;
        allow update: if isVerified() && isGroupMemberOf('studyGroups', groupId);
        allow delete: if (isGroupMemberOf('studyGroups', groupId) && resource.data.creatorId == request.auth.uid)
                      || isGroupCreatorOf('studyGroups', groupId)
                      || isModeratorDeletingPart('studyGroups', groupId, 'tasks', taskId);
      }

      match /checkIns/{checkInId} {
        allow read: if true;
        allow create: if isGroupMemberOf('studyGroups', groupId) && isValidNewCheckIn();
        allow update: if isEditingOwnCheckIn();
        // Lets the creator clear check-ins when deleting the group
        allow delete: if isGroupCreatorOf('studyGroups', groupId)
                      || isModeratorDeletingPart('studyGroups', groupId, 'checkIns', checkInId);
      }
    }

    match /bookClubs/{bookClubId} {
      allow read: if true;
      allow create: if canCreateGroup();
      allow update: if isJoiningGroup() || isLeavingGroup() || isEditingGroup() || isModeratorEditingGroup('bookClubs', bookClubId);
      allow delete: if (request.auth != null && resource.data.creatorId == request.auth.uid)
                    || isModeratorDeleting('bookClubs', bookClubId);

      match /tasks/{taskId} {
        allow read: if true;
        allow create: if isVerified() && isGroupMemberOf('bookClubs', bookClubId)
                      && request.resource.data.creatorId == request.auth.uid
                      && request.resource.data.isCompleted == false;
        allow update: if isVerified() && isGroupMemberOf('bookClubs', bookClubId);
        allow delete: if (isGroupMemberOf('bookClubs', bookClubId) && resource.data.creatorId == request.auth.uid)
                      || isGroupCreatorOf('bookClubs', bookClubId)
                      || isModeratorDeletingPart('bookClubs', bookClubId, 'tasks', taskId);
      }

      match /checkIns/{checkInId} {
        allow read: if true;
        allow create: if isGroupMemberOf('bookClubs', bookClubId) && isValidNewCheckIn();
        allow update: if isEditingOwnCheckIn();
        // Lets the creator clear check-ins when deleting the group
        allow delete: if isGroupCreatorOf('bookClubs', bookClubId)
                      || isModeratorDeletingPart('bookClubs', bookClubId, 'checkIns', checkInId);
      }
    }

    match /groupProjects/{groupProjectId} {
      allow read: if true;
      allow create: if canCreateGroup() && hasNoAnytimeJoin();
      allow update: if ((isJoiningGroup() || isLeavingGroup() || isEditingGroup()) && hasNoAnytimeJoin())
                    || isModeratorEditingGroup('groupProjects', groupProjectId);
      allow delete: if (request.auth != null && resource.data.creatorId == request.auth.uid)
                    || isModeratorDeleting('groupProjects', groupProjectId);

      match /tasks/{taskId} {
        allow read: if true;
        allow create: if isVerified() && isGroupMemberOf('groupProjects', groupProjectId)
                      && request.resource.data.creatorId == request.auth.uid
                      && request.resource.data.isCompleted == false;
        allow update: if isVerified() && isGroupMemberOf('groupProjects', groupProjectId);
        allow delete: if (isGroupMemberOf('groupProjects', groupProjectId) && resource.data.creatorId == request.auth.uid)
                      || isGroupCreatorOf('groupProjects', groupProjectId)
                      || isModeratorDeletingPart('groupProjects', groupProjectId, 'tasks', taskId);
      }

      match /checkIns/{checkInId} {
        allow read: if true;
        allow create: if isGroupMemberOf('groupProjects', groupProjectId) && isValidNewCheckIn();
        allow update: if isEditingOwnCheckIn();
        // Lets the creator clear check-ins when deleting the group
        allow delete: if isGroupCreatorOf('groupProjects', groupProjectId)
                      || isModeratorDeletingPart('groupProjects', groupProjectId, 'checkIns', checkInId);
      }
    }

    match /meetups/{meetupId} {
      allow read: if true;
      allow create: if isVerified()
                    && request.resource.data.creatorId == request.auth.uid
                    && request.resource.data.attendeeIds == [request.auth.uid];
      allow update: if isMeetupCreator(meetupId) || 
                    (isVerified() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendeeIds']) && isAddingSelfToList(request.resource.data.attendeeIds, resource.data.attendeeIds))
                    || isModeratorEditing('meetups', meetupId, ['name', 'name_lowercase', 'topic', 'description', 'locationAddress', 'virtualLink']);
      allow delete: if isMeetupCreator(meetupId) || isModeratorDeleting('meetups', meetupId);

      match /updates/{updateId} {
        allow read: if true;
        allow create: if isMeetupCreator(meetupId) && request.resource.data.creatorId == request.auth.uid;
        allow update: if false;
        allow delete: if isModeratorDeletingPart('meetups', meetupId, 'updates', updateId);
      }

      match /tasks/{taskId} {
        // Moderators can list them to delete them with the meetup
        allow read: if isMeetupAttendee(meetupId) || isModerator();
        allow create: if isVerified() && isMeetupAttendee(meetupId) && request.resource.data.creatorId == request.auth.uid && request.resource.data.isCompleted == false;
        allow update: if isMeetupAttendee(meetupId);
        allow delete: if (isMeetupAttendee(meetupId) && resource.data.creatorId == request.auth.uid) || isMeetupCreator(meetupId)
                      || isModeratorDeletingPart('meetups', meetupId, 'tasks', taskId);
      }
      
      match /checkIns/{checkInId} {
        allow read: if true;
        allow create: if isMeetupAttendee(meetupId) && isValidNewCheckIn();
        allow update: if isEditingOwnCheckIn();
        allow delete: if isModeratorDeletingPart('meetups', meetupId, 'checkIns', checkInId);
      }
    }
    
    match /soloProjects/{soloProjectId} {
      allow read: if true;
      allow create: if isVerified()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
                    && request.resource.data.projectUrl is string && request.resource.data.projectUrl.size() > 0
                    && request.resource.data.description is string && request.resource.data.description.size() <= 2000;
      allow update: if (request.auth != null && resource.data.userId == request.auth.uid)
                    || isModeratorEditing('soloProjects', soloProjectId, ['name', 'description', 'projectUrl']);
      allow delete: if (request.auth != null && resource.data.userId == request.auth.uid)
                    || isModeratorDeleting('soloProjects', soloProjectId);

      // The project owner's to-do list (src/components/TaskList.tsx), public
      // like the project
      match /tasks/{taskId} {
        allow read: if true;
        allow create: if isVerified() && isSoloProjectOwner(soloProjectId)
                      && request.resource.data.creatorId == request.auth.uid
                      && request.resource.data.isCompleted == false;
        allow update: if isSoloProjectOwner(soloProjectId);
        allow delete: if isSoloProjectOwner(soloProjectId)
                      || isModeratorDeletingPart('soloProjects', soloProjectId, 'tasks', taskId);
      }
    }

    function isSoloProjectOwner(soloProjectId) {
      return request.auth != null
             && get(/databases/$(database)/documents/soloProjects/$(soloProjectId)).data.userId == request.auth.uid;
    }

    match /users/{userId}/notifications/{notificationId} {
      allow read, write: if isOwner(userId);
    }

    // A member's private settings, like which notifications they want
    // (src/lib/notification-prefs.ts). Only the member can see them.
    match /users/{userId}/private/{docId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && (
        (docId == 'notificationPrefs'
          && request.resource.data.keys().hasOnly(['follows', 'groupMembers', 'groupActivity', 'requests', 'following', 'meetingReminders', 'replies', 'mentions'])
          && (!('follows' in request.resource.data) || request.resource.data.follows is bool)
          && (!('groupMembers' in request.resource.data) || request.resource.data.groupMembers is bool)
          && (!('groupActivity' in request.resource.data) || request.resource.data.groupActivity is bool)
          && (!('requests' in request.resource.data) || request.resource.data.requests is bool)
          && (!('following' in request.resource.data) || request.resource.data.following is bool)
          && (!('meetingReminders' in request.resource.data) || request.resource.data.meetingReminders is bool)
          && (!('replies' in request.resource.data) || request.resource.data.replies is bool)
          && (!('mentions' in request.resource.data) || request.resource.data.mentions is bool))
        // The feed's followed topics, muted and blocked members (FeedPrefs in src/lib/types.ts)
        || (docId == 'feedPrefs'
          && request.resource.data.keys().hasOnly(['topics', 'mutedIds', 'blockedIds', 'privateAccount'])
          && request.resource.data.get('privateAccount', false) is bool
          && request.resource.data.get('topics', []) is list && request.resource.data.get('topics', []).size() <= 30
          && request.resource.data.get('mutedIds', []) is list && request.resource.data.get('mutedIds', []).size() <= 500
          && request.resource.data.get('blockedIds', []) is list && request.resource.data.get('blockedIds', []).size() <= 500)
      );
    }

    // Each member's activity feed and notifications, written only by the
    // server (functions/src). Members can read their own, mark entries
    // read or unread, and delete them.
    match /users/{userId}/feed/{entryId} {
      allow read, delete: if isOwner(userId);
      allow create: if false;
      allow update: if isOwner(userId)
                    && changedKeys().hasOnly(['read'])
                    && request.resource.data.read is bool;
    }

    // Private reports about members or their posts
    // (src/components/ReportUserButton.tsx). Members can only file them;
    // moderators read them on /moderation and close them once handled.
    match /reports/{reportId} {
      allow read: if isModerator();
      allow update: if isModerator()
                    && changedKeys().hasOnly(['status', 'closedBy', 'closedAt'])
                    && resource.data.status == 'open'
                    && request.resource.data.status == 'closed'
                    && request.resource.data.closedBy == request.auth.uid
                    && request.resource.data.closedAt == request.time;
      allow delete: if false;
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(['reporterId', 'reportedUserId', 'postId', 'replyId', 'reason', 'details', 'page', 'status', 'createdAt'])
                    && request.resource.data.reporterId == request.auth.uid
                    && request.resource.data.reportedUserId is string
                    && request.resource.data.reportedUserId != request.auth.uid
                    && exists(/databases/$(database)/documents/users/$(request.resource.data.reportedUserId))
                    && request.resource.data.reason in ['harassment', 'spam', 'impersonation', 'inappropriate', 'inactive', 'other', 'off-topic', 'unsafe']
                    && request.resource.data.details is string && request.resource.data.details.size() <= 1000
                    && request.resource.data.page is string && request.resource.data.page.size() <= 300
                    && request.resource.data.status == 'open'
                    && request.resource.data.createdAt == request.time
                    && (!('replyId' in request.resource.data) || 'postId' in request.resource.data)
                    && (!('postId' in request.resource.data) || isReportingPost(reportId));
    }

    // A post report is named "<postId>_<reporter's uid>", and a reply report
    // "<postId>_<replyId>_<reporter's uid>", so each member can report each
    // only once, and the auto-hide (functions/src/reports.ts) counts
    // different members. It names the real author.
    function isReportingPost(reportId) {
      let data = request.resource.data;
      let postPath = /databases/$(database)/documents/memberPosts/$(data.postId);
      return isVerified()
             && data.postId is string
             && (('replyId' in data)
                 ? (data.replyId is string
                    && reportId == data.postId + '_' + data.replyId + '_' + request.auth.uid
                    && get(/databases/$(database)/documents/memberPosts/$(data.postId)/replies/$(data.replyId)).data.authorId == data.reportedUserId)
                 : (reportId == data.postId + '_' + request.auth.uid
                    && exists(postPath)
                    && get(postPath).data.authorId == data.reportedUserId));
    }

    // ---- Member posts: the public feed on /feed ----
    // Limits are in src/lib/member-posts.ts; keep them in step.

    // Words a post can't contain, as whole words in any case. Keep in step
    // with BLOCKED_WORDS in src/lib/member-posts.ts.
    function hasBlockedWord(text) {
      return text.lower().matches('(?s)(.*[^a-z0-9_])?(fuck|fucking|fucker|motherfucker|shit|bullshit|cunt|bitch|whore|slut|porn|porno|nudes|onlyfans|xxx|nigger|nigga|faggot|fag|retard|kys|free\\s+robux|free\\s+vbucks|asshole|dickhead|dumbass|jackass|bastard|twat|wanker|pussy|blowjob|handjob|cumshot|hentai|nsfw|sexting|send\\s+nudes|dick\\s+pic|chink|spic|kike|wetback|tranny|dyke|retarded|kill\\s+yourself|go\\s+die|free\\s+nitro|cashapp\\s+me|dm\\s+me\\s+for\\s+money)([^a-z0-9_].*)?');
    }

    // Text up to 500 characters, up to 3 topics, and an optional https link
    function isValidPostContent(data) {
      return data.text is string && data.text.size() > 0 && data.text.size() <= 500
             && !hasBlockedWord(data.text)
             && data.topics is list && data.topics.size() <= 3
             && (data.topics.size() == 0 || data.topics.join(',').matches('[a-z0-9-]{1,30}(,[a-z0-9-]{1,30}){0,2}'))
             && (!('linkUrl' in data) || (data.linkUrl is string && data.linkUrl.size() <= 500 && data.linkUrl.matches('https://[^\\s]+')));
    }

    // A private account's posts are for followers only, and people ask to
    // follow it. The flag is on the public profile (users.privateAccount);
    // accounts made private before that have it in feedPrefs.
    function hasPrivateAccount(userId) {
      let prefsPath = /databases/$(database)/documents/users/$(userId)/private/feedPrefs;
      return get(/databases/$(database)/documents/users/$(userId)).data.get('privateAccount', false) == true
             || (exists(prefsPath) && get(prefsPath).data.get('privateAccount', false) == true);
    }

    // Whether the signed-in member can see a visible post: everyone can see
    // public ones; followers-only ones are for the author's followers
    function canSeePost(post) {
      return post.status == 'visible'
             && (post.audience == 'public'
                 || (request.auth != null && (post.authorId == request.auth.uid || isFollowerOf(post.authorId))));
    }

    // Who a post is for: everyone, or the author's followers. Members with a
    // private account can only post to followers.
    function isAllowedAudience(data) {
      return data.audience in ['public', 'followers']
             && (data.audience == 'followers' || !hasPrivateAccount(request.auth.uid));
    }

    // An optional image the author uploaded to Storage for this post, at
    // memberPosts/<uid>/<postId>/<file> (storage.rules)
    function isValidPostImage(data, postId) {
      return (!('imageUrl' in data) && !('imagePath' in data))
             || (data.imagePath is string
                 && data.imagePath.matches('memberPosts/' + data.authorId + '/' + postId + '/[A-Za-z0-9._-]{1,100}')
                 && data.imageUrl is string && data.imageUrl.size() <= 1000
                 && data.imageUrl.matches('(https://firebasestorage[.]googleapis[.]com|http://127[.]0[.]0[.]1:[0-9]+)/v0/b/.+'));
    }

    // True when `userId` lists the signed-in member as a follower
    function isFollowerOf(userId) {
      return request.auth != null
             && get(/databases/$(database)/documents/users/$(userId)).data.get('followers', []).hasAny([request.auth.uid]);
    }

    function isSuspended(userId) {
      let standingPath = /databases/$(database)/documents/memberStandings/$(userId);
      return exists(standingPath)
             && get(standingPath).data.get('suspendedUntil', null) is timestamp
             && get(standingPath).data.suspendedUntil > request.time;
    }

    // The same save must count the post in postLimits (see below), which is
    // what caps posts per hour
    function isCountedPost(postId) {
      let limitsPath = /databases/$(database)/documents/postLimits/$(request.auth.uid);
      return getAfter(limitsPath).data.lastPostId == postId
             && (!exists(limitsPath) || get(limitsPath).data.lastPostId != postId);
    }

    function canCreatePost(postId) {
      let data = request.resource.data;
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isVerified()
             && data.keys().hasOnly(['authorId', 'authorName', 'authorPhoto', 'text', 'topics', 'linkUrl', 'audience', 'imageUrl', 'imagePath', 'status', 'createdAt'])
             && data.authorId == request.auth.uid
             && data.authorName == profile.username
             && data.authorPhoto == profile.get('profilePictureUrl', '')
             && data.status == 'visible'
             && data.createdAt == request.time
             && isValidPostContent(data)
             && isAllowedAudience(data)
             && isValidPostImage(data, postId)
             && !isSuspended(request.auth.uid)
             && isCountedPost(postId);
    }

    // Authors can change what their post says, not who wrote it or whether
    // it's hidden
    function isEditingOwnPost(postId) {
      return request.auth != null
             && resource.data.authorId == request.auth.uid
             && changedKeys().hasOnly(['text', 'topics', 'linkUrl', 'audience', 'imageUrl', 'imagePath', 'updatedAt'])
             // Changing only who sees it doesn't mark it as edited
             && (changedKeys().hasOnly(['audience']) || request.resource.data.updatedAt == request.time)
             && isValidPostContent(request.resource.data)
             && isAllowedAudience(request.resource.data)
             && isValidPostImage(request.resource.data, postId)
             && !isSuspended(request.auth.uid);
    }

    // A moderator hides or restores a post in the same save as a new
    // moderationLog entry about it, so every action is on the record
    function isModeratingPost(postId) {
      let logId = request.resource.data.moderationLogId;
      let logPath = /databases/$(database)/documents/moderationLog/$(logId);
      return isModerator()
             && changedKeys().hasOnly(['status', 'hiddenBy', 'moderationLogId'])
             && request.resource.data.status in ['visible', 'hidden']
             && (request.resource.data.status == 'visible'
                   ? !('hiddenBy' in request.resource.data)
                   : request.resource.data.hiddenBy == 'moderator')
             && logId is string
             && !exists(logPath)
             && getAfter(logPath).data.postId == postId
             && getAfter(logPath).data.action == (request.resource.data.status == 'hidden' ? 'hide' : 'restore');
    }

    // A moderator removes a post's image, keeping its text, with a
    // moderationLog entry about it; functions/src/post-checks.ts then
    // deletes the file
    function isRemovingPostImage(postId) {
      let logId = request.resource.data.moderationLogId;
      let logPath = /databases/$(database)/documents/moderationLog/$(logId);
      return isModerator()
             && changedKeys().hasOnly(['imageUrl', 'imagePath', 'moderationLogId'])
             && !('imageUrl' in request.resource.data) && !('imagePath' in request.resource.data)
             && logId is string
             && !exists(logPath)
             && getAfter(logPath).data.postId == postId
             && getAfter(logPath).data.action == 'remove-image';
    }

    match /memberPosts/{postId} {
      // Visible public posts are public, like profiles; visible
      // followers-only posts are for the author's followers. Hidden ones only
      // to moderators and the author, so the author can see why.
      allow read: if canSeePost(resource.data)
                  || isModerator()
                  || (request.auth != null && resource.data.authorId == request.auth.uid);
      allow create: if canCreatePost(postId);
      allow update: if isEditingOwnPost(postId) || isModeratingPost(postId) || isRemovingPostImage(postId)
                    || isCountingLike(postId);
      // Moderators log a deletion as moderationLog/delete-<postId>
      allow delete: if (request.auth != null && resource.data.authorId == request.auth.uid)
                    || (isModerator()
                        && !exists(/databases/$(database)/documents/moderationLog/$('delete-' + postId))
                        && existsAfter(/databases/$(database)/documents/moderationLog/$('delete-' + postId)));
    }

    // A like is saved as memberPosts/<postId>/likes/<uid>, with the post's
    // likeCount changed by one in the same save
    function isCountingLike(postId) {
      let likePath = /databases/$(database)/documents/memberPosts/$(postId)/likes/$(request.auth.uid);
      let before = resource.data.get('likeCount', 0);
      return request.auth != null
             && changedKeys().hasOnly(['likeCount'])
             && ((request.resource.data.likeCount == before + 1 && !exists(likePath) && existsAfter(likePath))
                 || (request.resource.data.likeCount == before - 1 && exists(likePath) && !existsAfter(likePath)));
    }

    // Who liked what isn't shown; each member reads only their own likes
    match /memberPosts/{postId}/likes/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isVerified()
                    && request.resource.data.keys().hasOnly(['createdAt'])
                    && request.resource.data.createdAt == request.time
                    && canSeePost(get(/databases/$(database)/documents/memberPosts/$(postId)).data)
                    && getAfter(/databases/$(database)/documents/memberPosts/$(postId)).data.get('likeCount', 0)
                         == get(/databases/$(database)/documents/memberPosts/$(postId)).data.get('likeCount', 0) + 1;
      allow update: if false;
      // A deleted post's likes go with it (functions/src/post-checks.ts)
      allow delete: if isOwner(userId)
                    && (!exists(/databases/$(database)/documents/memberPosts/$(postId))
                        || getAfter(/databases/$(database)/documents/memberPosts/$(postId)).data.get('likeCount', 0)
                             == get(/databases/$(database)/documents/memberPosts/$(postId)).data.get('likeCount', 0) - 1);
    }

    // The same save must count the reply in replyLimits (see below)
    function isCountedReply(postId, replyId) {
      let limitsPath = /databases/$(database)/documents/replyLimits/$(request.auth.uid);
      return getAfter(limitsPath).data.lastReplyId == replyId
             && getAfter(limitsPath).data.lastPostId == postId
             && (!exists(limitsPath) || get(limitsPath).data.lastReplyId != replyId);
    }

    function canCreateReply(postId, replyId) {
      let data = request.resource.data;
      let post = get(/databases/$(database)/documents/memberPosts/$(postId)).data;
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isVerified()
             && data.keys().hasOnly(['authorId', 'authorName', 'authorPhoto', 'text', 'status', 'createdAt'])
             && data.authorId == request.auth.uid
             && data.authorName == profile.username
             && data.authorPhoto == profile.get('profilePictureUrl', '')
             && data.status == 'visible'
             && data.createdAt == request.time
             && data.text is string && data.text.size() > 0 && data.text.size() <= 500
             && !hasBlockedWord(data.text)
             && canSeePost(post)
             && !hasBlocked(post.authorId, request.auth.uid)
             && !isSuspended(request.auth.uid)
             && isCountedReply(postId, replyId);
    }

    // A moderator hides or restores a reply with a moderationLog entry about it
    function isModeratingReply(postId, replyId) {
      let logId = request.resource.data.moderationLogId;
      let logPath = /databases/$(database)/documents/moderationLog/$(logId);
      return isModerator()
             && changedKeys().hasOnly(['status', 'hiddenBy', 'moderationLogId'])
             && request.resource.data.status in ['visible', 'hidden']
             && (request.resource.data.status == 'visible'
                   ? !('hiddenBy' in request.resource.data)
                   : request.resource.data.hiddenBy == 'moderator')
             && logId is string
             && !exists(logPath)
             && getAfter(logPath).data.postId == postId
             && getAfter(logPath).data.replyId == replyId
             && getAfter(logPath).data.action == (request.resource.data.status == 'hidden' ? 'hide' : 'restore');
    }

    // The reply's author changes its text; it shows as edited. Hidden
    // replies stay hidden, and functions/src/replies.ts checks the new text.
    function isEditingOwnReply(postId) {
      return request.auth != null
             && resource.data.authorId == request.auth.uid
             && changedKeys().hasOnly(['text', 'updatedAt'])
             && request.resource.data.updatedAt == request.time
             && request.resource.data.text is string
             && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
             && !hasBlockedWord(request.resource.data.text)
             && !isSuspended(request.auth.uid)
             && exists(/databases/$(database)/documents/memberPosts/$(postId));
    }

    // Replies to a post, readable by whoever can see the post. replyCount on
    // the post is kept by functions/src/replies.ts, which also checks the
    // text and tells the post's author.
    match /memberPosts/{postId}/replies/{replyId} {
      allow read: if (resource.data.status == 'visible'
                      && canSeePost(get(/databases/$(database)/documents/memberPosts/$(postId)).data))
                  || isModerator()
                  || (request.auth != null && resource.data.authorId == request.auth.uid);
      allow create: if canCreateReply(postId, replyId);
      allow update: if isModeratingReply(postId, replyId) || isEditingOwnReply(postId);
      // The reply's author, the post's author, or a moderator who logs it as
      // moderationLog/delete-<postId>-<replyId>
      allow delete: if (request.auth != null
                        && (resource.data.authorId == request.auth.uid
                            || get(/databases/$(database)/documents/memberPosts/$(postId)).data.authorId == request.auth.uid))
                    || (isModerator()
                        && !exists(/databases/$(database)/documents/moderationLog/$('delete-' + postId + '-' + replyId))
                        && existsAfter(/databases/$(database)/documents/moderationLog/$('delete-' + postId + '-' + replyId)));
    }

    // Like postLimits, for replies: up to 30 an hour. Keep in step with
    // REPLIES_PER_HOUR in src/lib/member-posts.ts.
    match /replyLimits/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
                    && request.resource.data.keys().hasOnly(['windowStart', 'count', 'lastPostId', 'lastReplyId'])
                    && request.resource.data.lastPostId is string
                    && request.resource.data.lastReplyId is string
                    && (resource == null || resource.data.lastReplyId != request.resource.data.lastReplyId)
                    && !exists(/databases/$(database)/documents/memberPosts/$(request.resource.data.lastPostId)/replies/$(request.resource.data.lastReplyId))
                    && existsAfter(/databases/$(database)/documents/memberPosts/$(request.resource.data.lastPostId)/replies/$(request.resource.data.lastReplyId))
                    && ((request.resource.data.count == 1
                          && request.resource.data.windowStart == request.time
                          && (resource == null || request.time >= resource.data.windowStart + duration.value(1, 'h')))
                        || (resource != null
                          && request.resource.data.windowStart == resource.data.windowStart
                          && request.resource.data.count == resource.data.count + 1
                          && request.resource.data.count <= 30));
      allow delete: if false;
    }

    // Asking to follow a private account, named "<their uid>_<your uid>".
    // They accept by adding you to their followers and deleting the request
    // in one save; functions/src/follows.ts then adds them to your following.
    match /followRequests/{requestId} {
      allow read: if request.auth != null
                  && (resource == null || resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid);
      allow create: if isVerified()
                    && request.resource.data.keys().hasOnly(['fromId', 'toId', 'fromName', 'fromPhoto', 'createdAt'])
                    && request.resource.data.fromId == request.auth.uid
                    && request.resource.data.toId is string
                    && request.resource.data.toId != request.auth.uid
                    && requestId == request.resource.data.toId + '_' + request.auth.uid
                    && request.resource.data.fromName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username
                    && request.resource.data.fromPhoto == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('profilePictureUrl', '')
                    && request.resource.data.createdAt == request.time
                    && hasPrivateAccount(request.resource.data.toId)
                    && !hasBlocked(request.resource.data.toId, request.auth.uid)
                    && !isFollowerOf(request.resource.data.toId);
      allow update: if false;
      allow delete: if request.auth != null
                    && (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid);
    }

    // A member asks moderators to look again at an action about them: a
    // hidden post or reply, a warning or a suspension. Named after the moderationLog
    // entry, so there's one appeal per action. Moderators answer it.
    match /appeals/{logId} {
      allow read: if isModerator()
                  || (request.auth != null && (resource == null || resource.data.userId == request.auth.uid));
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(['userId', 'action', 'postId', 'replyId', 'text', 'status', 'createdAt'])
                    && request.resource.data.userId == request.auth.uid
                    && get(/databases/$(database)/documents/moderationLog/$(logId)).data.targetUserId == request.auth.uid
                    && request.resource.data.action == get(/databases/$(database)/documents/moderationLog/$(logId)).data.action
                    && request.resource.data.action in ['hide', 'auto-hide', 'warn', 'suspend', 'remove-image']
                    && (!('postId' in request.resource.data)
                        || request.resource.data.postId == get(/databases/$(database)/documents/moderationLog/$(logId)).data.postId)
                    && (!('replyId' in request.resource.data)
                        || request.resource.data.replyId == get(/databases/$(database)/documents/moderationLog/$(logId)).data.get('replyId', null))
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
                    && request.resource.data.status == 'open'
                    && request.resource.data.createdAt == request.time;
      allow update: if isModerator()
                    && resource.data.status == 'open'
                    && changedKeys().hasOnly(['status', 'response', 'closedBy', 'closedAt'])
                    && request.resource.data.status in ['upheld', 'reversed']
                    && request.resource.data.response is string && request.resource.data.response.size() <= 500
                    && request.resource.data.closedBy == request.auth.uid
                    && request.resource.data.closedAt == request.time;
      allow delete: if false;
    }

    // How many posts each member has made in the current hour, saved with
    // every new post. A new window starts an hour after the last one began.
    // Keep the cap (5) in step with POSTS_PER_HOUR.
    match /postLimits/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
                    && request.resource.data.keys().hasOnly(['windowStart', 'count', 'lastPostId'])
                    && request.resource.data.lastPostId is string
                    && (resource == null || resource.data.lastPostId != request.resource.data.lastPostId)
                    && !exists(/databases/$(database)/documents/memberPosts/$(request.resource.data.lastPostId))
                    && existsAfter(/databases/$(database)/documents/memberPosts/$(request.resource.data.lastPostId))
                    && ((request.resource.data.count == 1
                          && request.resource.data.windowStart == request.time
                          && (resource == null || request.time >= resource.data.windowStart + duration.value(1, 'h')))
                        || (resource != null
                          && request.resource.data.windowStart == resource.data.windowStart
                          && request.resource.data.count == resource.data.count + 1
                          && request.resource.data.count <= 5));
      allow delete: if false;
    }

    // The items moderators can edit or delete (edit-content and
    // delete-content log entries), like "studyGroups/abc" or
    // "meetups/abc/checkIns/xyz"
    function isModeratedContentPath(path) {
      return path is string
             && path.matches('(studyGroups|groupProjects|bookClubs|meetups|competitions|jobs|soloProjects|serviceListings)/[A-Za-z0-9_-]+(/(tasks|checkIns|updates|entries)/[A-Za-z0-9_-]+)?');
    }

    // Every moderator action, for the record. Written by moderators with the
    // action itself, or by the auto-hide job; never changed or removed.
    match /moderationLog/{logId} {
      allow read: if isModerator();
      allow create: if isModerator()
                    && request.resource.data.keys().hasOnly(['actorId', 'action', 'targetUserId', 'postId', 'replyId', 'contentPath', 'note', 'createdAt'])
                    && request.resource.data.actorId == request.auth.uid
                    && request.resource.data.action in ['hide', 'restore', 'delete', 'dismiss', 'warn', 'suspend', 'unsuspend', 'remove-image', 'edit-content', 'delete-content']
                    && (!(request.resource.data.action in ['edit-content', 'delete-content']) || isModeratedContentPath(request.resource.data.contentPath))
                    && (request.resource.data.action != 'delete-content'
                        || logId == 'delete-' + request.resource.data.contentPath.replace('/', '-'))
                    && request.resource.data.targetUserId is string
                    && (!('postId' in request.resource.data) || request.resource.data.postId is string)
                    && (!('replyId' in request.resource.data) || (request.resource.data.replyId is string && 'postId' in request.resource.data))
                    && (request.resource.data.action != 'delete'
                        || logId == 'delete-' + request.resource.data.postId
                                     + (('replyId' in request.resource.data) ? '-' + request.resource.data.replyId : ''))
                    && request.resource.data.note is string && request.resource.data.note.size() <= 500
                    && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Who is on the moderation team, for the Team tab on /moderation.
    // Written only by the setModerator function, which also sets the claim.
    match /moderators/{userId} {
      allow read: if isModerator();
      allow write: if false;
    }

    // A member's warnings and suspension. Members can read their own, so the
    // feed can tell them; moderators change them with a moderationLog entry.
    match /memberStandings/{userId} {
      allow read: if isOwner(userId) || isModerator();
      allow create, update: if isModerator()
                    && request.resource.data.keys().hasOnly(['warnings', 'lastWarning', 'suspendedUntil', 'lastLogId', 'warnLogId', 'suspendLogId', 'updatedAt'])
                    && request.resource.data.warnings is int
                    && (!('lastWarning' in request.resource.data) || (request.resource.data.lastWarning is string && request.resource.data.lastWarning.size() <= 500))
                    && (request.resource.data.get('suspendedUntil', null) == null || request.resource.data.suspendedUntil is timestamp)
                    && request.resource.data.updatedAt == request.time
                    && request.resource.data.lastLogId is string
                    && !exists(/databases/$(database)/documents/moderationLog/$(request.resource.data.lastLogId))
                    && getAfter(/databases/$(database)/documents/moderationLog/$(request.resource.data.lastLogId)).data.targetUserId == userId
                    && getAfter(/databases/$(database)/documents/moderationLog/$(request.resource.data.lastLogId)).data.action in ['warn', 'suspend', 'unsuspend'];
      allow delete: if false;
    }

    match /feedback/{feedbackId} {
      allow read: if false;
      allow write: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.feedback is string
                    && request.resource.data.feedback.size() > 0
                    && request.resource.data.feedback.size() <= 2000;
    }

    match /supportRequests/{supportRequestId} {
      allow read: if false; 
      allow create: if request.auth != null
                     && request.resource.data.userId == request.auth.uid
                     && request.resource.data.subject is string
                     && request.resource.data.subject.size() > 0 && request.resource.data.subject.size() <= 100
                     && request.resource.data.description is string
                     && request.resource.data.description.size() > 0 && request.resource.data.description.size() <= 2000
                     && request.resource.data.status == 'open';
    }

    match /careerApplications/{applicationId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
